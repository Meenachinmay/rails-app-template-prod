# Copy to .env and adjust as needed:
#   cp .env.example .env

# App
APP_PORT=3000
RAILS_ENV=development
RAILS_MAX_THREADS=5

# PostgreSQL (Docker maps host 5435 -> container 5432)
POSTGRES_USER=bookkit
POSTGRES_PASSWORD=password
POSTGRES_DB=bookkit_development
POSTGRES_PORT=5435

# Used when running Rails on the host against Dockerized Postgres
POSTGRES_HOST=localhost
DATABASE_URL=postgres://bookkit:password@localhost:5435/bookkit_development
