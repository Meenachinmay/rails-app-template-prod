<%#
  locals:
    community: string (default "r/bookkit")
    author: string
    time_ago: string
    title: string
    body: string (optional HTML-safe text)
    flair: string (optional)
    score: integer
    comments: integer
%>
<%
  community ||= "r/bookkit"
  author ||= "u/system"
  time_ago ||= "just now"
  title ||= "Untitled"
  body ||= nil
  flair ||= nil
  score ||= 1
  comments ||= 0
%>

<article class="r-post">
  <div class="r-vote" aria-label="Vote">
    <button type="button" class="r-vote-btn" aria-label="Upvote">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 4l8 8h-5v8H9v-8H4l8-8z" />
      </svg>
    </button>
    <span class="tabular-nums text-text"><%= score %></span>
    <button type="button" class="r-vote-btn r-vote-btn-down" aria-label="Downvote">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 20l-8-8h5V4h6v8h5l-8 8z" />
      </svg>
    </button>
  </div>

  <div class="r-post-body">
    <div class="r-meta">
      <a href="#" class="r-community"><%= community %></a>
      <span>·</span>
      <span>Posted by <%= author %></span>
      <span>·</span>
      <time><%= time_ago %></time>
      <% if flair.present? %>
        <span class="r-flair ml-1"><%= flair %></span>
      <% end %>
    </div>

    <h2 class="r-title mt-1"><%= title %></h2>

    <% if body.present? %>
      <div class="mt-2 text-sm leading-relaxed text-text">
        <%= body %>
      </div>
    <% end %>

    <div class="mt-2 flex flex-wrap items-center gap-1">
      <button type="button" class="r-action">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M18 10c0 3.866-3.582 7-8 7a8.84 8.84 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7z" />
        </svg>
        <%= comments %> Comments
      </button>
      <button type="button" class="r-action">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z" />
        </svg>
        Share
      </button>
      <button type="button" class="r-action">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" />
        </svg>
        Save
      </button>
      <button type="button" class="r-action">•••</button>
    </div>
  </div>
</article>
