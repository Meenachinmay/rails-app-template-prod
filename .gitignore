# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Bundler
/.bundle
/vendor/bundle

# Environment & secrets
/.env
/.env.*
!/.env.example
/config/*.key
/config/credentials/*.key

# Logs and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Active Storage
/storage/*
!/storage/.keep

# Assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# IDE / OS
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store

# Test / coverage
/coverage/
/tmp/screenshots/

# Byebug / debug history
.byebug_history
